{
  "schema": "backend/1",
  "id": "mlx-embeddings",
  "version": "0.1.0",
  "builtin": false,
  "package": "mlx_embeddings",
  "convert": "mlx_embeddings.convert",
  "lock": "mlx-embeddings.lock",
  "ports": {
    "classification": [
      "laya"
    ]
  },
  "port_bits": {
    "laya": [
      8
    ]
  },
  "port_convert": {
    "laya": "convert"
  },
  "port_signatures": {
    "laya": [
      "rl_agent_config.json",
      "encoder/config.json",
      "tokenizer/tokenizer.json",
      "tokenizer/tokenizer_config.json",
      "model.safetensors"
    ]
  },
  "port_quantize": {
    "laya": {
      "include": [
        "encoder.layers.",
        "head.layers."
      ],
      "group_size": 32
    }
  },
  "categories": {
    "classification": "classifiers"
  },
  "remap_files": {},
  "registry": {
    "classification": {
      "model_types": [],
      "remapping": {}
    }
  }
}
