{
  "schema": "backend/1",
  "id": "mlx-embeddings",
  "version": "0.1.0",
  "builtin": false,
  "package": "mlx_embeddings",
  "convert": "mlx_embeddings.convert",
  "lock": "mlx-embeddings.lock",
  "ports": {
    "classification": [
      "kev",
      "laya"
    ]
  },
  "port_bits": {
    "kev": [
      8,
      32
    ],
    "laya": [
      6,
      8
    ]
  },
  "port_convert": {
    "kev": "convert",
    "laya": "convert"
  },
  "port_recipes": {
    "jaredpalmer/kev-4b": {
      "port": "kev",
      "base": "Qwen/Qwen3-4B-Base",
      "base_revision": "906bfd4b4dc7f14ee4320094d8b41684abff8539",
      "lora": "adapter_model.safetensors",
      "lora_scale": 1.0
    }
  },
  "port_signatures": {
    "kev": [
      "adapter_config.json",
      "adapter_model.safetensors",
      "head.pt"
    ],
    "laya": [
      "rl_agent_config.json",
      "encoder/config.json",
      "tokenizer/tokenizer.json",
      "tokenizer/tokenizer_config.json",
      "model.safetensors"
    ]
  },
  "port_quantize": {
    "kev": {
      "include": [
        "backbone.embed_tokens",
        "backbone.layers."
      ],
      "group_size": 64
    },
    "laya": {
      "include": [
        "encoder.layers.",
        "head.layers."
      ],
      "group_size": 32
    }
  },
  "categories": {
    "classification": "classifiers",
    "embedding": "models"
  },
  "remap_files": {},
  "registry": {
    "classification": {
      "model_types": [],
      "remapping": {}
    },
    "embedding": {
      "model_types": [
        "bert",
        "modernbert",
        "qwen3",
        "xlm_roberta",
        "lfm2",
        "llama_bidirec",
        "gemma3_text"
      ],
      "remapping": {}
    }
  }
}
