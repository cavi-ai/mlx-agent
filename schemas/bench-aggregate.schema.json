{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cavi-ai/mlx-agent/schemas/bench-aggregate.schema.json",
  "title": "mlx-agent bench aggregate",
  "oneOf": [
    {
      "$ref": "#/$defs/legacy"
    },
    {
      "$ref": "#/$defs/current"
    }
  ],
  "$defs": {
    "legacy": {
      "type": "object",
      "required": [
        "schema_version",
        "entries"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "entries": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "object",
            "required": [
              "repo",
              "chip",
              "decode_toks",
              "prefill_toks",
              "ttft_ms",
              "samples",
              "updated_at"
            ],
            "properties": {
              "repo": {
                "type": "string",
                "minLength": 1
              },
              "chip": {
                "type": "string",
                "minLength": 1
              },
              "decode_toks": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "prefill_toks": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "ttft_ms": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "samples": {
                "type": "integer",
                "minimum": 1
              },
              "updated_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "current": {
      "type": "object",
      "required": [
        "schema_version",
        "entries"
      ],
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "entries": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "object",
            "required": [
              "repo",
              "chip",
              "decode_toks",
              "prefill_toks",
              "ttft_ms",
              "samples",
              "updated_at",
              "runtime",
              "probe_id",
              "measurement_method",
              "gen_tokens",
              "prompt_tokens",
              "end_to_end_toks"
            ],
            "properties": {
              "repo": {
                "type": "string",
                "minLength": 1
              },
              "chip": {
                "type": "string",
                "minLength": 1
              },
              "decode_toks": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "prefill_toks": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "ttft_ms": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "samples": {
                "type": "integer",
                "minimum": 1
              },
              "updated_at": {
                "type": "string",
                "format": "date-time"
              },
              "runtime": {
                "type": "string",
                "minLength": 1
              },
              "probe_id": {
                "enum": [
                  "bench-v2",
                  null
                ]
              },
              "measurement_method": {
                "enum": [
                  "server_timings",
                  "client_wall_clock",
                  "latency_only",
                  "mixed",
                  "legacy_unclassified"
                ]
              },
              "gen_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 16,
                "maximum": 2048
              },
              "prompt_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1000000000
              },
              "end_to_end_toks": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1000000000
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
