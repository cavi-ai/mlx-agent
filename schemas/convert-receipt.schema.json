{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cavi-ai/mlx-agent/schemas/convert-receipt.schema.json",
  "title": "mlx-agent convert receipt",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "repo",
    "q_bits",
    "out",
    "argv",
    "pid",
    "log_path",
    "started_at",
    "preview_hash",
    "completed_at",
    "exit_status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "convert"
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "source": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "hf-cache",
            "gguf"
          ]
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "subfolder": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "signature": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "architecture": {
          "type": [
            "string",
            "null"
          ]
        },
        "quantization": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "projector": {
          "$ref": "#/$defs/projector"
        },
        "recipe": {
          "$ref": "#/$defs/recipe"
        },
        "fetch_receipt": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/dependency"
          }
        },
        "support": {
          "$ref": "#/$defs/support"
        }
      },
      "additionalProperties": false
    },
    "q_bits": {
      "enum": [
        4,
        5,
        6,
        8,
        32
      ]
    },
    "backend": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "out": {
      "type": "string",
      "minLength": 1
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pid": {
      "type": "integer",
      "minimum": 1
    },
    "log_path": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "preview_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "exit_status": {
      "enum": [
        "done",
        "failed",
        null
      ]
    },
    "model_type": {
      "type": "string",
      "minLength": 1
    },
    "require_completion": {
      "type": "boolean"
    },
    "launch_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "monitor_argv": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "completion_observed": {
      "type": "boolean"
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "worker_pid": {
      "type": "integer",
      "minimum": 1
    },
    "error": {
      "type": "string",
      "minLength": 1
    },
    "wait_for_compute_lease": {
      "type": "boolean"
    },
    "compute_lease_registered": {
      "type": "boolean"
    },
    "execution_group": {
      "type": "object",
      "required": ["pgid", "leader_identity"],
      "properties": {
        "pgid": {"type": "integer", "minimum": 1},
        "leader_identity": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "downloads_dir": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "origin": {
      "type": "object",
      "required": [
        "repo",
        "revision",
        "file",
        "subfolder",
        "additional_files"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "subfolder": {
          "type": [
            "string",
            "null"
          ]
        },
        "additional_files": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "recipe": {
      "type": "object",
      "required": [
        "base",
        "base_revision",
        "lora",
        "lora_scale"
      ],
      "properties": {
        "base": {
          "type": "string",
          "minLength": 1
        },
        "base_revision": {
          "type": "string",
          "minLength": 1
        },
        "lora": {
          "type": "string",
          "minLength": 1
        },
        "lora_scale": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "projector": {
      "type": "object",
      "required": [
        "path",
        "name",
        "bytes",
        "signature",
        "fingerprint"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "signature": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "fetch_receipt": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "required": [
        "origin",
        "path",
        "fingerprint",
        "fetch_receipt"
      ],
      "properties": {
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "fetch_receipt": {
          "type": "string",
          "minLength": 1
        },
        "support": {
          "$ref": "#/$defs/support"
        }
      },
      "additionalProperties": false
    },
    "support": {
      "type": "object",
      "required": [
        "downloads_dir",
        "downloads",
        "files"
      ],
      "properties": {
        "downloads_dir": {
          "type": "string",
          "minLength": 1
        },
        "downloads": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "url",
              "sha256",
              "size"
            ],
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "bytes",
              "signature"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "signature": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
