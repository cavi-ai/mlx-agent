{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cavi-ai/mlx-agent/schemas/convert-receipt.schema.json",
  "title": "mlx-agent convert receipt",
  "type": "object",
  "required": [
    "schema_version", "kind", "repo", "q_bits", "out", "argv", "pid",
    "log_path", "started_at", "preview_hash", "completed_at", "exit_status"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "convert" },
    "repo": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$" },
    "source": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["hf-cache", "gguf"] },
        "repo": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "signature": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "architecture": { "type": ["string", "null"] },
        "quantization": { "type": ["string", "null"] },
        "model_key": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "q_bits": { "enum": [4, 8] },
    "out": { "type": "string", "minLength": 1 },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "type": "string", "minLength": 1 }
    },
    "pid": { "type": "integer", "minimum": 1 },
    "log_path": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "format": "date-time" },
    "preview_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "exit_status": { "enum": ["done", "failed", null] }
  },
  "additionalProperties": false
}
