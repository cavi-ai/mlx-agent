{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cavi-ai/mlx-agent/schemas/lora-receipt.schema.json",
  "title": "mlx-agent lora receipt",
  "type": "object",
  "required": [
    "schema_version", "kind", "repo", "data", "iters", "out", "argv", "pid",
    "log_path", "started_at", "preview_hash", "completed_at", "exit_status"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "lora" },
    "repo": { "type": "string", "minLength": 1 },
    "data": { "type": "string", "minLength": 1 },
    "iters": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "out": { "type": "string", "minLength": 1 },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1 }
    },
    "pid": { "type": "integer", "minimum": 1 },
    "log_path": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "format": "date-time" },
    "preview_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "exit_status": { "enum": ["done", "failed", null] }
  },
  "additionalProperties": false
}
