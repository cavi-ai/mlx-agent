{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cavi-ai/mlx-agent/schemas/serve-receipt.schema.json",
  "title": "mlx-agent serve receipt",
  "type": "object",
  "required": [
    "schema_version", "kind", "repo", "runtime", "port", "argv", "pid",
    "log_path", "readiness", "started_at", "preview_hash"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "serve" },
    "repo": { "type": ["string", "null"], "minLength": 1 },
    "path": { "type": ["string", "null"], "minLength": 1 },
    "jit": { "type": "boolean" },
    "runtime": { "enum": ["mlx_lm", "mlx-vlm", "strata", "tasks"] },
    "task_kinds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "strata_decoding": { "enum": ["plain", "lookup", "mtp"] },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1 }
    },
    "pid": { "type": "integer", "minimum": 1 },
    "log_path": { "type": "string", "minLength": 1 },
    "readiness": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "format": "date-time" },
    "preview_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "decode_profile": {
      "type": "object",
      "required": [
        "name",
        "fingerprint",
        "versions",
        "sources",
        "adapter_enabled",
        "runtime_executable"
      ],
      "properties": {
        "name": {
          "enum": ["prompt-lookup-v1", "prompt-lookup-v2", "prompt-lookup-v3"]
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "adapter_enabled": {
          "type": "boolean"
        },
        "runtime_executable": {
          "type": "string",
          "minLength": 1
        },
        "versions": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "sources": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "additionalProperties": false
    },
    "strata_memory_allocation": {
      "type": "object",
      "required": ["budget_bytes", "estimated_resident_bytes", "expert_memory_gb", "mode"],
      "properties": {
        "budget_bytes": { "type": "integer", "minimum": 1000000000 },
        "estimated_resident_bytes": { "type": "integer", "minimum": 1 },
        "expert_memory_gb": { "type": ["number", "null"], "minimum": 0.5, "maximum": 64 },
        "mode": { "enum": ["resident", "paged"] }
      },
      "additionalProperties": false
    },
    "vision_profile": {
      "type": "object",
      "required": ["name", "fingerprint", "runtime_executable", "runtime_python", "versions", "runtime_sources", "sources", "max_bytes", "max_entries", "adapter_enabled"],
      "properties": {
        "name": { "const": "vision-features-v1" },
        "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "runtime_executable": { "type": "string", "minLength": 1 },
        "runtime_python": { "type": ["string", "null"] },
        "versions": { "type": "object", "additionalProperties": { "type": ["string", "null"] } },
        "runtime_sources": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
        "sources": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
        "max_bytes": { "const": 134217728 },
        "max_entries": { "const": 20 },
        "adapter_enabled": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "prefill_kernel": {
      "type": "object",
      "required": ["name", "fingerprint", "versions", "sources", "adapter_enabled", "runtime_executable"],
      "properties": {
        "name": { "enum": ["m5-q4-prefill-v1", "m5-q4-prefill-v2"] },
        "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "adapter_enabled": { "type": "boolean" },
        "runtime_executable": { "type": "string", "minLength": 1 },
        "versions": { "type": "object", "additionalProperties": { "type": ["string", "null"] } },
        "sources": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    { "properties": { "repo": { "type": "string" } } },
    { "required": ["path"], "properties": { "repo": { "type": "null" }, "path": { "type": "string" } } }
  ],
  "additionalProperties": false
}
