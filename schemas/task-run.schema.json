{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Durable inference task record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "kind", "state", "model_path", "created_at", "started_at", "completed_at", "cancel_requested", "identity", "request", "result", "error", "supervisor", "execution", "execution_unresolved"],
  "properties": {
    "schema": {"const": "task-run/1"},
    "id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "kind": {"enum": ["classification", "music_generation"]},
    "state": {"enum": ["starting", "running", "succeeded", "failed", "cancelled"]},
    "model_path": {"type": "string", "pattern": "^/"},
    "created_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "cancel_requested": {"type": "boolean"},
    "execution_unresolved": {"type": "boolean"},
    "identity": {"type": "object"},
    "request": {"type": "object"},
    "result": {"type": ["object", "null"]},
    "error": {"type": ["object", "null"]},
    "supervisor": {"type": ["object", "null"]},
    "execution": {"type": ["object", "null"]}
  },
  "allOf": [
    {"if": {"properties": {"state": {"enum": ["succeeded", "failed", "cancelled"]}}}, "then": {"properties": {"completed_at": {"type": "string"}}}, "else": {"properties": {"completed_at": {"type": "null"}}}},
    {"if": {"properties": {"state": {"const": "succeeded"}}}, "then": {"properties": {"result": {"type": "object"}}}},
    {"if": {"properties": {"state": {"const": "failed"}}}, "then": {"properties": {"error": {"type": "object"}}}}
  ]
}
